# AWS/SST
AWS_PROFILE=kaio-silva
SST_STAGE=sandbox

# Local Payment Federation runtime
PAYMENT_PROVIDER_MODE=mercado-pago
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_API_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_CONNECTION_TIMEOUT=5s
MERCADO_PAGO_READ_TIMEOUT=15s

# Opt-in Mercado Pago test-environment verification
MERCADO_PAGO_SANDBOX_CONFIRM=CREATE_AND_REFUND_TEST_PAYMENTS
MERCADO_PAGO_SANDBOX_BEARER_TOKEN=
MERCADO_PAGO_SANDBOX_CARD_TOKEN=
MERCADO_PAGO_SANDBOX_PAYMENT_METHOD_ID=visa
MERCADO_PAGO_SANDBOX_PAYER_EMAIL=
MERCADO_PAGO_SANDBOX_AMOUNT=1
MERCADO_PAGO_SANDBOX_CARD_ORDER_ID=
MERCADO_PAGO_SANDBOX_PIX_ORDER_ID=
MERCADO_PAGO_SANDBOX_GRAPHQL_URL=
MERCADO_PAGO_SANDBOX_WEBHOOK_URL=
