{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@desafio-dev-backend-senior/commerce-subgraph",
  "projectType": "application",
  "sourceRoot": "apps/commerce-subgraph/src",
  "tags": ["type:app", "scope:commerce"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-transform-types --check apps/commerce-subgraph/src/main.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-transform-types --test --test-reporter=tap test/milestone-3-*.test.mjs test/milestone-5-commerce-subscription.test.mjs"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-transform-types apps/commerce-subgraph/src/main.ts"
      }
    },
    "acceptance": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-transform-types --test --test-reporter=tap test/milestone-3-*.test.mjs"
      }
    }
  }
}
