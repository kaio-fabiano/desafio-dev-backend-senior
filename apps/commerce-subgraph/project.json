{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@desafio-dev-backend-senior/commerce-subgraph",
  "projectType": "application",
  "sourceRoot": "apps/commerce-subgraph/src",
  "tags": ["type:app", "scope:commerce"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-transform-types --check apps/commerce-subgraph/src/main.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/commerce-subgraph/tsconfig.app.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/test/delivery-closure-rabbitmq.test.mjs"
      ],
      "options": {
        "command": "node --experimental-transform-types --test --test-reporter=tap test/delivery-closure-rabbitmq.test.mjs"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-transform-types apps/commerce-subgraph/src/main.ts"
      }
    }
  }
}
