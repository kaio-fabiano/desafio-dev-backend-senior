{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@desafio-dev-backend-senior/identity-subgraph",
  "projectType": "application",
  "sourceRoot": "apps/identity-subgraph/src",
  "tags": ["type:app", "scope:identity"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-transform-types --check apps/identity-subgraph/src/main.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/identity-subgraph/tsconfig.app.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-transform-types --test --test-reporter=tap test/milestone-2-identity-catalog.test.mjs test/milestone-8-identity-gateway.test.mjs"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-transform-types apps/identity-subgraph/src/auth/seed.ts"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-transform-types apps/identity-subgraph/src/main.ts"
      }
    }
  }
}
