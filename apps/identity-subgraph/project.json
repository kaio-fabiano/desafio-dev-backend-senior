{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@desafio-dev-backend-senior/identity-subgraph",
  "projectType": "application",
  "sourceRoot": "apps/identity-subgraph/src",
  "tags": ["type:app", "scope:identity"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "outputs": ["{workspaceRoot}/dist/out-tsc/apps/identity-subgraph"],
      "options": {
        "command": "tsc -p apps/identity-subgraph/tsconfig.app.json --emitDeclarationOnly false --rewriteRelativeImportExtensions"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/identity-subgraph/tsconfig.app.json --noEmit"
      }
    },
    "test-typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc -p apps/identity-subgraph/tsconfig.spec.json"
      }
    },
    "test": {
      "dependsOn": ["test-typecheck"],
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run apps/identity-subgraph && NODE_ENV=test TSX_TSCONFIG_PATH=tsconfig.base.json node --import tsx --test --test-reporter=tap test/identity-federation-refactor.test.mjs test/milestone-2-identity-catalog.test.mjs test/milestone-8-identity-gateway.test.mjs"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "TSX_TSCONFIG_PATH=tsconfig.base.json node --import tsx apps/identity-subgraph/src/main.ts"
      }
    }
  }
}
