{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@desafio-dev-backend-senior/order-workflow-subgraph",
  "projectType": "application",
  "sourceRoot": "apps/order-workflow-subgraph/src",
  "tags": ["type:app", "scope:order-workflow"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "outputs": ["{workspaceRoot}/dist/out-tsc/apps/order-workflow-subgraph"],
      "options": {
        "command": "tsc -p apps/order-workflow-subgraph/tsconfig.app.json --emitDeclarationOnly false --rewriteRelativeImportExtensions"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/order-workflow-subgraph/tsconfig.app.json --noEmit"
      }
    },
    "test-typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc -p apps/order-workflow-subgraph/tsconfig.spec.json"
      }
    },
    "test": {
      "dependsOn": ["test-typecheck"],
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/test/delivery-closure-rabbitmq.test.mjs",
        "{workspaceRoot}/test/structural-commerce-review.test.mjs",
        "{workspaceRoot}/test/production-happy-path-hardening.spec.test.js"
      ],
      "options": {
        "command": "vitest run apps/order-workflow-subgraph test/production-happy-path-hardening.spec.test.js && TSX_TSCONFIG_PATH=tsconfig.base.json node --import tsx --test --test-reporter=tap test/delivery-closure-rabbitmq.test.mjs test/structural-commerce-review.test.mjs test/modularize-order-workflow-subgraph.test.mjs"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "TSX_TSCONFIG_PATH=apps/order-workflow-subgraph/tsconfig.app.json node --import tsx apps/order-workflow-subgraph/src/main.ts"
      }
    }
  }
}
