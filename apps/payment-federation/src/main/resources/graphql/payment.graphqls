extend schema
  @link(url: "https://specs.apollo.dev/federation/v2.11", import: ["@key"])

type Payment @key(fields: "id") {
  id: ID!
  operationKey: ID!
  orderId: ID!
  method: PaymentMethod!
  amount: Float!
  currency: String!
  status: PaymentStatus!
  providerReference: ID!
  pixCode: String
}

input AuthorizePaymentInput {
  operationKey: ID!
  paymentId: ID!
  orderId: ID!
  method: PaymentMethod!
  amount: Float!
  currency: String!
  providerToken: String
  payerEmail: String!
  paymentMethodId: String
}

enum PaymentMethod {
  CARD
  PIX
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PIX_GENERATED
  REFUNDED
  REJECTED
}

type Query {
  payment(id: ID!): Payment
}

type Mutation {
  authorizePayment(input: AuthorizePaymentInput!): Payment!
}
