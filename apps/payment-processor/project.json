{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@desafio-dev-backend-senior/payment-processor",
  "projectType": "application",
  "sourceRoot": "apps/payment-processor/src/main",
  "tags": ["type:app", "scope:payment"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "gradle --no-daemon bootJar",
        "cwd": "apps/payment-processor"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "gradle --no-daemon test",
        "cwd": "apps/payment-processor"
      }
    }
  }
}
