{
  "name": "@desafio-dev-backend-senior/wordpress-integration",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "root": "apps/wordpress-integration",
  "tags": ["type:tooling", "scope:wordpress"],
  "targets": {
    "probe": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash apps/wordpress-integration/scripts/install-plugins.sh && node apps/wordpress-integration/scripts/probe.mjs"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test --test-reporter=tap test/marco-0-wordpress.test.mjs"
      }
    }
  }
}
