{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desafio.dev/contracts/events/envelope.schema.json",
  "title": "Common event envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "traceContext", "operationKey"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "minLength": 1 },
    "eventVersion": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "traceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceId"],
      "properties": {
        "traceId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "spanId": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
      }
    },
    "operationKey": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" }
  }
}
