{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desafio.dev/contracts/events/payment-authorized.v1.schema.json",
  "title": "Payment authorized event v1",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    { "type": "object", "properties": { "eventType": { "const": "payment.authorized" }, "eventVersion": { "const": "v1" }, "payload": { "type": "object", "additionalProperties": false, "required": ["paymentId"], "properties": { "paymentId": { "type": "string", "minLength": 1 }, "orderId": { "type": "string", "minLength": 1 } } } }, "required": ["payload"] }
  ]
}
