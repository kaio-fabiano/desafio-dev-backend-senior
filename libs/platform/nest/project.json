{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "@desafio-dev-backend-senior/platform-nest",
  "projectType": "library",
  "sourceRoot": "libs/platform/nest/src",
  "tags": ["type:lib", "scope:platform"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/platform/nest/tsconfig.lib.json"
      },
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "outputs": ["{workspaceRoot}/dist/out-tsc/libs/platform/nest"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/platform/nest/tsconfig.lib.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint libs/platform/nest/src"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p libs/platform/nest/tsconfig.spec.json",
          "vitest run libs/platform/nest",
          "node --test --test-reporter=tap test/nest-provider-composition.test.mjs"
        ]
      }
    },
    "test-typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/platform/nest/tsconfig.spec.json"
      }
    },
    "unit": {
      "executor": "nx:run-commands",
      "dependsOn": ["test-typecheck"],
      "options": {
        "command": "vitest run libs/platform/nest"
      }
    },
    "contract": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test --test-reporter=tap test/nest-provider-composition.test.mjs"
      }
    },
    "coverage": {
      "executor": "nx:run-commands",
      "dependsOn": ["test-typecheck"],
      "options": {
        "command": "vitest run libs/platform/nest --coverage"
      }
    }
  }
}
