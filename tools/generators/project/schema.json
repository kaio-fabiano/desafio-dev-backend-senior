{
  "$schema": "http://json-schema.org/schema",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9-]*$" },
    "scope": { "type": "string", "enum": ["gateway", "identity", "commerce", "contract", "shared"] },
    "type": { "type": "string", "enum": ["app", "lib"], "default": "lib" }
  },
  "required": ["name", "scope"]
}
